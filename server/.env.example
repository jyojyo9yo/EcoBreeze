# Copy to .env and fill in real values. Never commit .env.

DEVICE_ID=cam1

MQTT_HOST=YOUR_CLUSTER_ID.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD

# Supabase project URL + service_role key (Project Settings -> API).
# The service_role key bypasses RLS -- keep it server-side only, never in the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

PERSON_CONF_THRESHOLD=0.5
ON_STREAK=2
OFF_STREAK=3
