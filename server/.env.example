# Copy to .env and fill in real values. Never commit .env.

DEVICE_ID=cam1

# The ESP32's local IP (printed to Serial on boot). Server and board must be
# on the same network.
ESP32_IP=192.168.1.100

# Supabase project URL + service_role key (Project Settings -> API).
# The service_role key bypasses RLS -- keep it server-side only, never in the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

PERSON_CONF_THRESHOLD=0.5
ON_STREAK=2
OFF_STREAK=3
HEARTBEAT_INTERVAL_S=5
POLL_INTERVAL_S=1.5
